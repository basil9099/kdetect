*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.vscode/
.vs/
.idea/

# Live captures — contain hostnames, paths, running processes
/captures/
/data/baselines/*.json
/data/baselines/*.json.sig
!/data/baselines/.gitkeep

# Kernel build artifacts
kmod/*.ko
kmod/*.o
kmod/.*.cmd
kmod/Module.symvers
kmod/modules.order

# NEVER commit rootkit source or binaries
/lab/targets/**
!/lab/targets/README.md

# Never commit key material
id_*
*.pem
*_rsa
*_ed25519
kmod/*.mod
kmod/*.mod.c

# SDD execution scratch (ledger, briefs, review packages)
.superpowers/
